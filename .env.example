# Neon Postgres — a project called "yazlik" is already provisioned
DATABASE_URL=

# better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Email. Three routes, first configured wins: SMTP, then Resend, then the
# console. Leave all of them empty in development and every message prints to
# the terminal running the app — which is also how you read a magic link.
#
# SMTP is for testing deliverability against a real mail client. Point it at a
# local Mailpit/Mailhog (host localhost, port 1025, no user or password) or at
# Ethereal, and open the message rather than reading its HTML in a log. It is
# checked BEFORE Resend on purpose, so a Resend key left lying here does not
# quietly send your test mail to the real service.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Only needed when the port does not imply it: 465 is secure, everything else
# starts plain and upgrades with STARTTLS.
SMTP_SECURE=

RESEND_API_KEY=
EMAIL_FROM=

# Images: "local" writes to .uploads/, "blob" uses Vercel Blob.
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=

# Cron
CRON_SECRET=

# Google Calendar (phase 6 — see SETUP-GOOGLE.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
